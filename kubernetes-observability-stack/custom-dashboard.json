        },
        "targets": [
          {
            "refId": "A",
            "expr": "sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"default\",pod=~\"sample-web-app.*\"}[2m]))",
            "legendFormat": "{{pod}}",
