{
  "podRunAsNonRoot": true,
  "podRunAsUser": 10001,
  "containers": [
    {
      "name": "nginx",
      "runAsNonRoot": true,
      "allowPrivilegeEscalation": false,
      "droppedCapabilities": [
        "ALL"
      ],
      "requests": {
        "cpu": "25m",
        "memory": "32Mi"
      },
      "limits": {
        "cpu": "100m",
        "memory": "64Mi"
      },
      "livenessProbe": true,
      "readinessProbe": true
    }
  ]
}
